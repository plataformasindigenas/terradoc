{#- Every article, A–Z, with its summary. Category chips filter the list (td.js; they are
    shown only with script); ?category=a/b from v1 links works too. -#}
{% extends "base.html.j2" %}
{% from "components/macros.html.j2" import counted %}
{% block main %}
<div class="td-list td-list--articles">
  <header class="td-list__head">
    <h1>{{ title }}</h1>
    <p class="td-list__count">{{ counted(t, 'encyclopedia', items | length, locale) }}</p>
  </header>
  {% if t.encyclopedia_intro %}<p class="td-list__intro">{{ t.encyclopedia_intro }}</p>{% endif %}
  {% set filter_target = "items" %}{% include "components/list_filter.html.j2" %}
  {% if categories | length > 1 %}
  <nav class="td-chips" aria-label="{{ t.ui_categories }}" data-td-chips="items" hidden>
    <ul>
      <li><a href="encyclopedia.html" data-td-category="">{{ t.ui_all }}</a></li>
      {% for c in categories %}<li><a href="encyclopedia.html?category={{ c.key | urlencode }}" data-td-category="{{ c.key }}">{{ t['category_' ~ c.key] or c.key | replace('-', ' ') | capitalize }}</a> <span class="td-groups__n">{{ c.count }}</span></li>{% endfor %}
    </ul>
  </nav>
  {% endif %}
  <ul class="td-articles" id="items">
    {% for i in items %}
    <li data-td-item data-td-categories="{{ (i.row.categories or []) | join('|') }}">
      <a class="td-articles__title" id="i-{{ i.id }}" href="encyclopedia/{{ i.file | urlencode }}"{% if locale != 'pt' %} lang="pt-BR"{% endif %}>{{ i.name }}</a>
      {% if i.row.abstract %}<p class="td-articles__abstract"{% if locale != 'pt' %} lang="pt-BR"{% endif %}>{{ gloss(i.row.abstract) }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
